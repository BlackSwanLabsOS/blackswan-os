# BlackSwanOS — root env template (Hardhat / deploy scripts)
# Copy to `.env` and fill in locally. Never commit real secrets.
#
# MCP agent keys live in:
#   mcp_server/.env.buyer
#   mcp_server/.env.seller
# (see mcp_server/.env.*.example)

# Deployer / owner key (Base Sepolia or local)
PRIVATE_KEY=

# RPC (Alchemy, QuickNode, or https://sepolia.base.org)
BASE_SEPOLIA_RPC_URL=

# Optional: contract verification on BaseScan
BASESCAN_API_KEY=

# Optional: funded test wallets for Sepolia scripts
SEPOLIA_BUYER_PRIVATE_KEY=
SEPOLIA_SELLER_PRIVATE_KEY=

# Deployed BlackSwanOS + USDC
CONTRACT_ADDRESS=
# Circle's public Base Sepolia USDC — safe to ship as the default example address
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
